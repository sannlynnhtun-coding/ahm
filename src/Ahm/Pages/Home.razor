@page "/"
@page "/setup"
@page "/cashier"
@page "/member"
@using Ahm.Models
@using Ahm.Services
@inject BrowserStore Store
@inject SheetApi Api
@inject NavigationManager Nav
@inject IJSRuntime Js

@if (!loaded)
{
    <div class="rounded-2xl border border-zinc-200 bg-white p-6 text-sm text-zinc-500">Loading your shop…</div>
}
else if (page == "setup")
{
    <div class="space-y-6">
        <section class="rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wider text-zinc-400"><span class="mr-2 inline-block h-2 w-2 rounded-full bg-emerald-500"></span>Initial onboarding</p>
            <h1 class="mt-2 text-lg font-semibold">ဆိုင် စတင်ချိတ်ဆက်ခြင်း (Shop Setup)</h1>
            <p class="mt-2 text-xs leading-relaxed text-zinc-500">သင့် Google Sheet နှင့် Apps Script Web App URL ကို ချိတ်ဆက်ပါ။ ဆိုင်အချက်အလက်များကို ဤ Browser ၏ IndexedDB တွင် သိမ်းဆည်းပါမည်။</p>
        </section>
        <section aria-labelledby="sheet-guide-title" class="rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-zinc-400">Google Sheets connection</p>
                    <h2 id="sheet-guide-title" class="mt-1 text-base font-semibold">Get your Apps Script Web App URL</h2>
                    <p class="mt-1 text-xs leading-relaxed text-zinc-500">Complete these steps once for your shop, then fill in the form below.</p>
                </div>
                <a href="https://sheets.google.com" target="_blank" rel="noopener noreferrer" class="inline-flex h-9 items-center rounded-lg border border-zinc-200 px-3 text-xs font-medium hover:bg-zinc-50">Open Google Sheets ↗</a>
            </div>
            <ol class="mt-5 space-y-4">
                <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-zinc-900 font-mono text-[11px] text-white">1</span><div><p class="text-xs font-semibold">Create a blank Google Sheet</p><p class="mt-1 text-xs leading-relaxed text-zinc-500">Name it for your shop. In the Sheet, choose <strong class="font-medium text-zinc-700">Extensions → Apps Script</strong>.</p></div></li>
                <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-zinc-900 font-mono text-[11px] text-white">2</span><div><p class="text-xs font-semibold">Paste the Ahm script</p><p class="mt-1 text-xs leading-relaxed text-zinc-500">Replace everything in <span class="font-mono">Code.gs</span> with the code below, then save the Apps Script project.</p><div class="mt-2 flex flex-wrap gap-3"><button type="button" @onclick="CopyScript" class="rounded-lg bg-zinc-900 px-3 py-2 text-xs font-medium text-white hover:bg-black">Copy Apps Script code</button><a href="/setup/Ahm-Code.gs.txt" target="_blank" rel="noopener noreferrer" class="self-center text-xs font-medium underline underline-offset-2">View code</a></div></div></li>
                <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-zinc-900 font-mono text-[11px] text-white">3</span><div><p class="text-xs font-semibold">Set a private cashier PIN</p><p class="mt-1 text-xs leading-relaxed text-zinc-500">In Apps Script, open <strong class="font-medium text-zinc-700">Project Settings → Script properties</strong>. Add a property named <span class="font-mono text-zinc-700">CASHIER_PIN</span> with a unique value of at least 8 characters. <a href="https://developers.google.com/apps-script/guides/properties" target="_blank" rel="noopener noreferrer" class="font-medium underline underline-offset-2">Script properties help ↗</a></p></div></li>
                <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-zinc-900 font-mono text-[11px] text-white">4</span><div><p class="text-xs font-semibold">Initialize the Sheet</p><p class="mt-1 text-xs leading-relaxed text-zinc-500">In the Apps Script editor, select <span class="font-mono text-zinc-700">initializeAhm</span> in the function menu and click <strong class="font-medium text-zinc-700">Run</strong>. Complete Google's authorization prompt.</p></div></li>
                <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-zinc-900 font-mono text-[11px] text-white">5</span><div><p class="text-xs font-semibold">Deploy as a Web App</p><p class="mt-1 text-xs leading-relaxed text-zinc-500">Choose <strong class="font-medium text-zinc-700">Deploy → New deployment → Web app</strong>. Set <strong class="font-medium text-zinc-700">Execute as: Me</strong> and <strong class="font-medium text-zinc-700">Who has access: Anyone</strong>, then click Deploy. Copy the Web App URL ending in <span class="font-mono text-zinc-700">/exec</span>. <a href="https://developers.google.com/apps-script/guides/web" target="_blank" rel="noopener noreferrer" class="font-medium underline underline-offset-2">Web App help ↗</a></p></div></li>
                <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-zinc-900 font-mono text-[11px] text-white">6</span><div><p class="text-xs font-semibold">Connect Ahm</p><p class="mt-1 text-xs leading-relaxed text-zinc-500">Paste that <span class="font-mono">/exec</span> URL and the same cashier PIN into the form below. Add your shop details and save.</p></div></li>
            </ol>
        </section>
        <form @onsubmit="SaveSetup" @onsubmit:preventDefault class="space-y-5 rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm">
            <div class="space-y-1.5"><label for="shopName" class="block text-xs font-medium">ဆိုင်အမည် (Shop Name)</label><input id="shopName" required maxlength="100" @bind="setup.ShopName" placeholder="ဥပမာ - Shwe Tea House" class="h-11 w-full rounded-xl border border-zinc-200 bg-zinc-50/50 px-3.5 text-sm" /></div>
            <div class="space-y-1.5"><label for="gasUrl" class="block text-xs font-medium">Google Apps Script Web App URL</label><input id="gasUrl" required type="url" @bind="setup.GasUrl" placeholder="https://script.google.com/macros/s/.../exec" class="h-11 w-full rounded-xl border border-zinc-200 bg-zinc-50/50 px-3.5 font-mono text-xs" /><p class="text-[11px] text-zinc-400">Use the deployed /exec URL from your own Sheet's script.</p></div>
            <div class="space-y-1.5"><label for="setupPin" class="block text-xs font-medium">Cashier PIN</label><input id="setupPin" required type="password" autocomplete="off" @bind="pin" placeholder="PIN set in Apps Script properties" class="h-11 w-full rounded-xl border border-zinc-200 bg-zinc-50/50 px-3.5 text-sm" /><p class="text-[11px] text-zinc-400">Used for this browser session only. The PIN is not saved in IndexedDB.</p></div>
            <div class="border-t border-zinc-100 pt-4">
                <h2 class="mb-4 text-xs font-semibold">Auto Reward &amp; Policy Settings (မူဝါဒ သတ်မှတ်ချက်များ)</h2>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-1"><label for="minSpend" class="text-[11px] text-zinc-500">Min Spend / Stamp (MMK)</label><input id="minSpend" required type="number" min="1" @bind="setup.Policy.MinSpendPerStamp" class="h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50/50 px-3 font-mono text-sm" /></div>
                    <div class="space-y-1"><label for="maxStamps" class="text-[11px] text-zinc-500">Target Stamps</label><input id="maxStamps" required type="number" min="1" max="30" @bind="setup.Policy.MaxStamps" class="h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50/50 px-3 font-mono text-sm" /></div>
                    <div class="space-y-1"><label for="reward" class="text-[11px] text-zinc-500">Cashback Reward (MMK)</label><input id="reward" required type="number" min="1" @bind="setup.Policy.CashbackReward" class="h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50/50 px-3 font-mono text-sm" /></div>
                    <div class="space-y-1"><label for="minWithdrawal" class="text-[11px] text-zinc-500">Min Withdrawal (MMK)</label><input id="minWithdrawal" required type="number" min="1" @bind="setup.Policy.MinWithdrawal" class="h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50/50 px-3 font-mono text-sm" /></div>
                </div>
                <label class="mt-4 flex items-center gap-2.5 text-xs text-zinc-600"><input type="checkbox" @bind="setup.Policy.AllowRollover" class="h-4 w-4 accent-black" /> ပိုလျှံသော Stamp များကို နောက်ကတ်သို့ Rollover ကူးပြောင်းခွင့်ပြုမည်</label>
            </div>
            <button disabled="@busy" type="submit" class="h-11 w-full rounded-xl bg-zinc-900 px-4 text-xs font-medium text-white hover:bg-black">@(busy ? "Connecting…" : "Save to IndexedDB & Initialize")</button>
        </form>
        <p class="px-2 text-[11px] text-zinc-400">Customer data remains in your Google Sheet. This site uses a small Vercel request relay for reliable Google Apps Script responses.</p>
    </div>
}
else if (page == "cashier")
{
    <div class="space-y-6">
        <div class="flex items-start justify-between gap-4"><div><p class="text-xs uppercase tracking-wider text-zinc-400">Cashier</p><h1 class="mt-1 text-lg font-semibold">@setup.ShopName</h1></div><span class="rounded-full bg-zinc-100 px-3 py-1 font-mono text-[11px] text-zinc-500">POS</span></div>
        <section class="space-y-4 rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm">
            <div class="space-y-1"><label for="cashierPin" class="text-xs font-medium text-zinc-600">Cashier PIN</label><input id="cashierPin" type="password" autocomplete="off" @bind="pin" placeholder="Enter PIN for this session" class="h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50/50 px-3 text-sm" /></div>
            <div class="space-y-1"><label for="lookup" class="text-xs font-medium text-zinc-600">Customer Search</label><div class="flex gap-2"><input id="lookup" @bind="lookup" @bind:event="oninput" @onkeydown="LookupKeyDown" placeholder="Phone number or QR token" class="h-11 min-w-0 flex-1 rounded-xl border border-zinc-200 bg-zinc-50/50 px-3.5 font-mono text-sm" /><button type="button" disabled="@busy" @onclick="FindMember" class="rounded-xl bg-zinc-900 px-4 text-xs font-medium text-white">Find</button><button type="button" title="Scan QR code" aria-label="Scan QR code" @onclick="ScanQr" class="rounded-xl border border-zinc-200 px-3 text-lg text-zinc-700">▦</button></div></div>
        </section>
        @if (showEnroll)
        {
            <form @onsubmit="Enroll" @onsubmit:preventDefault class="space-y-4 rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm"><h2 class="text-sm font-semibold">New customer</h2><p class="text-xs text-zinc-500">No member found for @lookup. Add their name to create a card.</p><label for="newName" class="block text-xs font-medium">Customer name</label><input id="newName" required maxlength="100" @bind="newName" class="h-11 w-full rounded-xl border border-zinc-200 px-3 text-sm" /><button disabled="@busy" class="h-11 w-full rounded-xl bg-zinc-900 text-xs font-medium text-white">Create member card</button></form>
        }
        @if (member is not null)
        {
            <section class="space-y-6 rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm">
                <div class="flex items-start justify-between gap-3 border-b border-zinc-100 pb-4"><div><h2 class="text-base font-semibold">@member.Name</h2><p class="mt-0.5 font-mono text-xs text-zinc-400">@member.Phone</p></div><div class="text-right"><p class="text-[11px] text-zinc-400">Cashback</p><p class="font-mono text-base font-semibold">@Money(member.AvailableCashback) MMK</p></div></div>
                <div><div class="flex justify-between text-xs"><span class="text-zinc-500">Current Card Progress</span><span class="font-mono font-semibold">@member.Stamps of @setup.Policy.MaxStamps stamps</span></div><div class="mt-2 h-2 overflow-hidden rounded-full bg-zinc-100"><div class="h-full rounded-full bg-zinc-900" style="width: @(Math.Min(100, member.Stamps * 100 / Math.Max(1, setup.Policy.MaxStamps)))%"></div></div></div>
                <div class="space-y-1"><label for="spend" class="text-xs text-zinc-500">Bill amount (MMK)</label><input id="spend" type="number" min="0" @bind="spend" class="h-10 w-full rounded-lg border border-zinc-200 px-3 font-mono text-sm" /></div>
                <div class="grid grid-cols-2 gap-3"><button type="button" disabled="@(busy || spend < setup.Policy.MinSpendPerStamp)" @onclick="AddStamp" class="h-12 rounded-xl bg-zinc-900 text-xs font-medium text-white">+ Add 1 Stamp</button><button type="button" disabled="@(busy || member.AvailableCashback < setup.Policy.MinWithdrawal)" @onclick="Withdraw" class="h-12 rounded-xl border border-zinc-200 text-xs font-medium">Cash Out @Money(member.AvailableCashback)</button></div>
                <p class="text-[11px] text-zinc-400">Minimum bill: @Money(setup.Policy.MinSpendPerStamp) MMK. Minimum payout: @Money(setup.Policy.MinWithdrawal) MMK.</p>
                @if (memberLink.Length > 0)
                {
                    <div class="border-t border-zinc-100 pt-4"><p class="mb-2 text-xs font-semibold">Customer QR</p><div id="memberQr" class="inline-block rounded-lg border border-zinc-100 p-2"></div><p class="mt-2 break-all font-mono text-[11px] text-zinc-400">@MemberUrl()</p><button type="button" @onclick="CopyMemberUrl" class="mt-2 text-xs font-medium underline">Copy member link</button></div>
                }
            </section>
        }
        <p class="flex justify-between px-2 text-[11px] text-zinc-400"><span><span class="mr-1 inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Shop configured</span><span class="font-mono">Rule: @Money(setup.Policy.MinSpendPerStamp) MMK = 1 Stamp</span></p>
    </div>
}
else
{
    <div class="space-y-6">
        @if (member is null)
        {
            <section class="rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm"><h1 class="text-lg font-semibold">Customer card</h1><p class="mt-2 text-sm text-zinc-500">@(page == "member" ? "This member link is invalid or the card could not be loaded. Ask your shop for a new QR code." : "Scan your member QR code to see your stamps and cashback.")</p>@if (page != "member" && setup.GasUrl.Length == 0) { <a href="/setup" class="mt-4 inline-block text-xs font-medium underline">Set up your shop</a> }</section>
        }
        else
        {
            <section class="flex items-start justify-between gap-3 rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm"><div><p class="text-xs font-medium uppercase tracking-wider text-zinc-400">@setup.ShopName</p><h1 class="mt-1 text-lg font-semibold">@member.Name</h1><p class="mt-0.5 font-mono text-xs text-zinc-500">@member.Phone</p></div><div class="text-right"><p class="text-xs text-zinc-400">Available Balance</p><p class="mt-0.5 font-mono text-xl font-semibold">@Money(member.AvailableCashback) <span class="text-xs font-normal text-zinc-500">MMK</span></p></div></section>
            <section class="space-y-5 rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm"><div class="flex items-start justify-between gap-2"><div><h2 class="text-sm font-semibold">Stamp Progress</h2><p class="mt-0.5 text-xs text-zinc-500">Spend @Money(setup.Policy.MinSpendPerStamp) MMK per visit to earn 1 stamp</p></div><span class="shrink-0 rounded-md bg-zinc-100 px-2.5 py-1 font-mono text-xs font-semibold">@member.Stamps / @setup.Policy.MaxStamps</span></div><div class="grid grid-cols-5 gap-2 py-1 sm:grid-cols-10 sm:gap-3">@for (var i = 1; i <= setup.Policy.MaxStamps; i++) { var earned = i <= member.Stamps; <div class="flex aspect-square items-center justify-center rounded-full text-[11px] @(earned ? "bg-zinc-900 font-bold text-white" : "border border-zinc-200 bg-zinc-50 font-mono text-zinc-400")">@(earned ? "✓" : i.ToString())</div> }</div><div class="flex flex-wrap justify-between gap-2 border-t border-zinc-100 pt-3 text-xs text-zinc-500"><span>နောက် @Math.Max(0, setup.Policy.MaxStamps - member.Stamps) ကြိမ် သုံးစွဲပါက <strong class="font-mono text-zinc-900">@Money(setup.Policy.CashbackReward) MMK</strong> ရရှိပါမည်</span><span class="font-mono text-[11px]">Lifetime: @Money(member.LifetimeCashback) MMK</span></div></section>
            <section class="rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-sm"><h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Activity History</h2>@if (member.History.Count == 0) { <p class="mt-4 text-xs text-zinc-400">No activity yet.</p> } else { <div class="mt-3 divide-y divide-zinc-100">@foreach (var item in member.History) { <div class="flex justify-between gap-3 py-3 text-xs"><div><p class="font-medium text-zinc-800">@ActionLabel(item.Action)</p><p class="mt-0.5 font-mono text-[11px] text-zinc-400">@item.Timestamp</p></div><span class="font-mono font-medium">@(item.Action == "STAMP_ADD" ? "+1 Stamp" : (item.Delta >= 0 ? "+" : "") + Money(item.Delta) + " MMK")</span></div> }</div> }</section>
        }
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div role="status" class="fixed bottom-6 left-1/2 z-40 w-max max-w-[90vw] -translate-x-1/2 rounded-full bg-zinc-900 px-4 py-2.5 text-xs font-medium text-white shadow-lg">@message</div>
}
