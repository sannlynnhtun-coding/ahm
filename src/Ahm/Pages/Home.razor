@page "/"
@page "/setup"
@page "/cashier"
@page "/member"
@page "/privacy"
@page "/terms"
@using Ahm.Models
@using Ahm.Services
@inject BrowserStore Store
@inject GoogleSheetsService Sheets
@inject NavigationManager Nav
@inject IConfiguration Configuration
@inject IJSRuntime Js

<PageTitle>@Title</PageTitle>
@if (page == "member") { <HeadContent><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" /></HeadContent> }

<div class="mb-5 flex justify-end">
    <button type="button" @onclick="ToggleLanguage" class="rounded-lg border border-zinc-200 bg-white px-3 text-xs font-semibold">@(burmese ? "English" : "မြန်မာ")</button>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div role="@(messageIsError ? "alert" : "status")" class="mb-6 flex items-start justify-between gap-3 rounded-xl border p-4 text-sm @(messageIsError ? "border-red-300 bg-red-50 text-red-900" : "border-brand-100 bg-brand-50 text-brand-900")">
        <p>@message</p><button type="button" class="shrink-0 font-semibold underline" @onclick="DismissMessage">@T("ပိတ်မည်", "Dismiss")</button>
    </div>
}

@if (!loaded)
{
    <div role="status" class="rounded-2xl border border-zinc-200 bg-white p-6 text-sm">@T("အမ်းကို ဖွင့်နေသည်…", "Loading Ahm…")</div>
}
else if (page == "privacy")
{
    <article class="prose prose-zinc rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Privacy</p>
        <h1 class="mt-2 text-xl font-semibold">@T("ကိုယ်ရေးအချက်အလက် မူဝါဒ", "Privacy Policy")</h1>
        <p class="mt-4 text-sm leading-7">@T("အမ်း application သည် Google access token၊ ဆိုင်မှတ်တမ်း သို့မဟုတ် customer မှတ်တမ်းများကို အမ်း server တွင် သိမ်းဆည်းခြင်း မပြုပါ။ Google token ကို browser memory ထဲတွင် session အတွင်းသာ ထားပြီး ဆိုင်၏ Google Sheet ကို browser မှ တိုက်ရိုက်ဖတ်/ရေးသည်။", "The Ahm application does not persist Google tokens or shop/customer records. A Google token exists only in browser memory for the active session, and the browser reads and writes the shop's Google Sheet directly.")</p>
        <p class="mt-3 text-sm leading-7">@T("Sheet ID၊ public shop ID၊ staff label နှင့် UI preference ကဲ့သို့ secret မဟုတ်သော ဆက်သွယ်မှု setting များကို browser IndexedDB ထဲ သိမ်းနိုင်သည်။ Static host/CDN သည် ၎င်းတို့၏ terms အတိုင်း ပုံမှန် access log များကို process လုပ်နိုင်သည်။", "Non-secret connection settings such as the Sheet ID, public shop ID, staff label and UI preferences may be stored in browser IndexedDB. The static host/CDN may process standard access logs under its own terms.")</p>
        <p class="mt-3 text-sm leading-7">@T("Legacy QR redirect သည် code ကို ခဏတာ decrypt လုပ်ပြီး route အသစ်သို့ ပြန်ညွှန်းပေးသော်လည်း request/customer data ကို သိမ်းခြင်း သို့မဟုတ် application log ရေးခြင်း မပြုပါ။", "The legacy QR redirect transiently decrypts the code and redirects to the new route; it does not store request/customer data or write application logs.")</p>
    </article>
}
else if (page == "terms")
{
    <article class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Terms</p>
        <h1 class="mt-2 text-xl font-semibold">@T("အသုံးပြုမှု စည်းကမ်းချက်များ", "Terms of Service")</h1>
        <p class="mt-4 text-sm leading-7">@T("အမ်းသည် အခမဲ့ community tool ဖြစ်ပြီး Google Sheets နှင့် static hosting quota/policy များအပေါ် မူတည်သည်။ ဆိုင်၏ Sheet Editor အားလုံးကို trusted operator အဖြစ် သတ်မှတ်ထားသည်။", "Ahm is a free community tool subject to Google Sheets and static-hosting quotas and policy changes. Every editor of a shop's Sheet is treated as a trusted operator.")</p>
        <p class="mt-3 text-sm leading-7">@T("ဆိုင်ပိုင်ရှင်သည် Sheet sharing၊ customer consent၊ reward terms နှင့် backup များကို စီမံရန် တာဝန်ရှိသည်။ အမ်းသည် payment processor သို့မဟုတ် accounting system မဟုတ်ပါ။", "The shop owner is responsible for Sheet sharing, customer consent, reward terms and backups. Ahm is not a payment processor or accounting system.")</p>
    </article>
}
else if (page == "member")
{
    <section class="space-y-5 rounded-2xl border border-zinc-200 bg-white p-6 text-center shadow-sm">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-2xl">◇</div>
        <div><p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Staff-assisted member ID</p><h1 class="mt-2 text-xl font-semibold">@T("ဤ QR ကို ဆိုင်ဝန်ထမ်းအား ပြပါ", "Show this QR to shop staff")</h1></div>
        <p class="text-sm leading-6 text-zinc-700">@T("ဤစာမျက်နှာတွင် balance သို့မဟုတ် customer အချက်အလက် မပြပါ။ ချိတ်ထားသော အမ်း Sheet ကို authorize လုပ်ထားသည့် ဝန်ထမ်းကသာ member record ကို ရှာနိုင်သည်။", "This page does not show balances or customer details. Only staff authorized for the connected Ahm Sheet can look up the member record.")</p>
        @if (validMemberLink)
        {
            <div id="publicMemberQr" class="mx-auto h-56 w-56 rounded-xl border border-zinc-200 bg-white p-3"></div>
            <p class="break-all font-mono text-xs text-zinc-600">@memberToken</p>
            @if (setup.PublicShopId == publicShopId)
            {
                <a href="@($"/cashier?s={Uri.EscapeDataString(publicShopId)}&t={Uri.EscapeDataString(memberToken)}")" class="inline-flex min-h-11 items-center rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@T("ဝန်ထမ်းအဖြစ် ဖွင့်မည်", "Open staff lookup")</a>
            }
        }
        else { <p role="alert" class="text-sm text-red-800">@T("Member link မမှန်ပါ။ ဆိုင်ထံမှ QR အသစ်တောင်းပါ။", "This member link is invalid. Ask the shop for a new QR.")</p> }
    </section>
}
else if (page == "setup")
{
    <div class="space-y-6">
        <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Google Sheets direct</p>
            <h1 class="mt-2 text-xl font-semibold">@T("ဆိုင် Sheet ချိတ်ဆက်ခြင်း", "Connect your shop Sheet")</h1>
            <p class="mt-2 text-sm leading-6 text-zinc-700">@T("Desktop၊ Apps Script၊ database နှင့် cashier PIN မလိုပါ။ Google account ကို ခွင့်ပြုပြီး mobile browser မှ Sheet ကို တိုက်ရိုက်ရွေးပါ။", "No desktop, Apps Script, database or cashier PIN is required. Authorize Google and select the Sheet directly from a mobile browser.")</p>
            @if (!googleConfigured) { <p role="alert" class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">Google public configuration is missing. Set <code>Google:ClientId</code>, <code>Google:ApiKey</code> and <code>Google:AppId</code> before deployment.</p> }
            <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" disabled="@(!googleConfigured || busy)" @onclick="ConnectGoogle" class="rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@(googleConnected ? T("Google ပြန်ချိတ်မည်", "Reconnect Google") : T("Google ချိတ်မည်", "Connect Google"))</button>
                @if (googleConnected) { <span class="self-center text-xs font-medium text-brand-700">● @T("ဤ session အတွက် ချိတ်ထားသည်", "Connected for this session")</span> }
            </div>
            <p class="mt-3 text-xs text-zinc-600">@T("တောင်းဆိုသည့် scope: Google ၏ official “See, edit, create, and delete only the specific Google Drive files you use with this app” (drive.file). Token ကို browser memory မှာသာ ထားသည်။", "Requested scope: Google's official “See, edit, create, and delete only the specific Google Drive files you use with this app” (drive.file). The token stays in browser memory only.")</p>
        </section>

        <section class="space-y-4 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <label class="block text-sm font-medium">@T("ဆိုင်အမည်", "Shop name")<input maxlength="100" @bind="setup.ShopName" placeholder="e.g. Shwe Tea House" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
            <label class="block text-sm font-medium">@T("ဤဖုန်း၏ ဝန်ထမ်းအမည်", "Staff label on this device")<input maxlength="100" @bind="setup.StaffLabel" placeholder="e.g. Front counter" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
            <div class="grid gap-3 sm:grid-cols-2">
                <button type="button" disabled="@(!googleConnected || busy)" @onclick="CreateShop" class="rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@T("Ahm Sheet အသစ်ဖန်တီးမည်", "Create new Ahm Sheet")</button>
                <button type="button" disabled="@(!googleConnected || busy)" @onclick="ConnectExisting" class="rounded-xl border border-zinc-300 px-4 text-sm font-semibold">@T("ရှိပြီး Sheet ရွေးမည်", "Connect existing Sheet")</button>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(setup.SpreadsheetId))
        {
            <form @onsubmit="SaveSettings" @onsubmit:preventDefault class="space-y-5 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
                <div><p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Connected</p><h2 class="mt-1 text-lg font-semibold">@setup.ShopName</h2><p class="mt-1 break-all font-mono text-xs text-zinc-500">Sheet @setup.SpreadsheetId</p></div>
                <label class="block text-sm font-medium">@T("ဆိုင်အမည်", "Shop name")<input required maxlength="100" @bind="setup.ShopName" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                <div class="grid gap-4 sm:grid-cols-2">
                    <label class="text-sm">Spend per stamp (MMK)<input required type="number" min="1" @bind="setup.Policy.MinSpendPerStamp" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                    <label class="text-sm">Stamps per card<input required type="number" min="1" max="30" @bind="setup.Policy.MaxStamps" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                    <label class="text-sm">Minimum payout (MMK)<input required type="number" min="1" @bind="setup.Policy.MinWithdrawal" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                </div>
                <div class="space-y-3 border-t border-zinc-100 pt-4">
                    <div class="flex items-center justify-between"><h2 class="font-semibold">Reward catalog</h2><button id="add-reward" type="button" @onclick="AddReward" class="text-sm font-semibold underline">Add reward</button></div>
                    @foreach (var reward in setup.Rewards)
                    {
                        <fieldset @key="reward.Id" class="space-y-3 rounded-xl border border-zinc-200 p-4">
                            <label class="block text-sm">Name<input required maxlength="100" @bind="reward.Name" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3" /></label>
                            <label class="block text-sm">Type<select @bind="reward.Type" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3"><option value="CASHBACK">Cashback</option><option value="PERCENT_DISCOUNT">Percentage discount</option><option value="FREE_ITEM">Free item</option></select></label>
                            @if (reward.Type != "FREE_ITEM") { <label class="block text-sm">Value<input type="number" min="1" @bind="reward.Value" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3" /></label> }
                            @if (reward.Type == "PERCENT_DISCOUNT") { <label class="block text-sm">Maximum discount<input type="number" min="0" @bind="reward.MaxDiscount" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3" /></label> }
                            <label class="block text-sm">Stock (blank = unlimited)<input type="number" min="0" @bind="reward.StockQuantity" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3" /></label>
                            <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" @bind="reward.Active" class="h-5 w-5" /> Active</label>
                            <button type="button" @onclick="() => DisableReward(reward)" class="text-sm font-semibold text-red-800 underline">@(reward.Active ? "Disable" : "Remove")</button>
                        </fieldset>
                    }
                </div>
                <button disabled="@(!googleConnected || busy)" class="h-11 w-full rounded-xl bg-brand-700 text-sm font-semibold text-white">@T("Setting များ Sheet သို့ သိမ်းမည်", "Save settings to Sheet")</button>
            </form>
        }

        <details class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer font-semibold">@T("Apps Script v2 ဆိုင် ပြောင်းရွှေ့မည်", "Migrate an Apps Script v2 shop")</summary>
            <p class="mt-3 text-sm leading-6 text-zinc-700">@T("Old Sheet ကို Picker ဖြင့်ရွေးပြီး member state ကို v3 ledger သို့ ကူးမည်။ ပြီးလျှင် old tabs များကို Legacy_ အမည်ပြောင်းကာ stale Apps Script writes ကို ရပ်မည်။", "Choose the old Sheet in Picker. Ahm copies current member state into the v3 ledger, archives logs, then renames old tabs with Legacy_ to stop stale Apps Script writes.")</p>
            <label class="mt-3 block text-sm">Legacy Apps Script URL<input type="url" @bind="legacyGasUrl" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3 font-mono text-xs" /></label>
            <button type="button" disabled="@(!googleConnected || busy)" @onclick="MigrateLegacy" class="mt-3 rounded-xl border border-zinc-300 px-4 text-sm font-semibold">@T("Old Sheet ရွေးပြီး migrate မည်", "Choose old Sheet and migrate")</button>
        </details>
    </div>
}
else if (page == "cashier")
{
    <div class="space-y-6">
        <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Staff workspace</p><h1 class="mt-1 text-xl font-semibold">@(string.IsNullOrWhiteSpace(setup.ShopName) ? "Ahm" : setup.ShopName)</h1></div><button type="button" disabled="@(!googleConfigured || busy)" @onclick="ConnectGoogle" class="rounded-xl border border-zinc-300 px-3 text-sm font-semibold">@(googleConnected ? T("ပြန် sync မည်", "Sync now") : T("Google ပြန်ချိတ်မည်", "Reconnect Google"))</button></div>
            @if (string.IsNullOrWhiteSpace(setup.SpreadsheetId)) { <p class="mt-4 text-sm"><a href="/setup" class="font-semibold underline">@T("ဆိုင် Sheet အရင်ချိတ်ပါ", "Connect a shop Sheet first")</a></p> }
            else if (!googleConnected) { <p class="mt-3 text-sm text-amber-800">@T("Token သက်တမ်းကုန် သို့မဟုတ် page reload ဖြစ်သည်။ ပြင်ဆင်မှုအားလုံးကို ရပ်ထားပြီး Reconnect Google ကို ကိုယ်တိုင်နှိပ်ရမည်။", "The token expired or the page was reloaded. Mutations are paused until you explicitly reconnect Google.")</p> }
        </section>
        <section class="space-y-3 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <label class="block text-sm font-medium">@T("ဖုန်းနံပါတ်၊ member token သို့မဟုတ် QR link", "Phone, member token or QR link")<input @bind="lookup" @bind:event="oninput" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
            <div class="flex flex-wrap gap-2"><button type="button" disabled="@(!googleConnected || busy)" @onclick="FindMember" class="rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@T("Member ရှာမည်", "Find member")</button><button type="button" disabled="@(!googleConnected || busy)" @onclick="ScanQr" class="rounded-xl border border-zinc-300 px-4 text-sm font-semibold">@T("QR scan မည်", "Scan QR")</button></div>
        </section>
        @if (showEnroll)
        {
            <form @onsubmit="Enroll" @onsubmit:preventDefault class="space-y-3 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm"><h2 class="font-semibold">@T("Member အသစ်", "New member")</h2><label class="block text-sm">Name<input required maxlength="100" @bind="newName" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label><button disabled="@busy" class="h-11 w-full rounded-xl bg-brand-700 text-sm font-semibold text-white">@T("Member ဖန်တီးမည်", "Create member")</button></form>
        }
        @if (member is not null)
        {
            <section class="space-y-5 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
                <div class="flex flex-wrap justify-between gap-3"><div><h2 class="text-lg font-semibold">@member.Name</h2><p class="text-sm text-zinc-600">@member.Phone</p></div><div class="text-right"><p class="text-xs text-zinc-600">Cashback</p><p class="font-semibold text-brand-800">@Money(member.AvailableCashback) MMK</p></div></div>
                <p class="text-sm">@member.Stamps / @setup.Policy.MaxStamps stamps · @member.RewardCredits reward choices · @Money(member.SpendRemainder) MMK carried</p>
                <label class="block text-sm">Bill amount (MMK)<input type="number" min="1" @bind="spend" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                <button type="button" disabled="@(!googleConnected || busy || spend < 1)" @onclick="RecordPurchase" class="h-11 w-full rounded-xl bg-brand-700 text-sm font-semibold text-white">@T("ဝယ်ယူမှု မှတ်တမ်းတင်မည်", "Record purchase")</button>
                @if (member.RewardCredits > 0)
                {
                    <div class="space-y-2 border-t border-zinc-100 pt-4"><h3 class="font-semibold">@T("Reward ရွေးမည်", "Select reward")</h3>@foreach (var reward in setup.Rewards.Where(r => r.Active)) { <button type="button" disabled="@(busy || RemainingStock(reward) == 0)" @onclick="() => SelectReward(reward)" class="flex min-h-11 w-full items-center justify-between rounded-xl border border-zinc-200 px-3 text-left text-sm"><span>@reward.Name</span><span>@RewardLabel(reward)@(RemainingStock(reward) is int remaining ? $" · {remaining} left" : "")</span></button> }</div>
                }
                @if (member.Claims.Any(c => c.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase)))
                {
                    <div class="space-y-2 border-t border-zinc-100 pt-4"><h3 class="font-semibold">@T("အသုံးပြုရန် Reward", "Rewards to redeem")</h3>@foreach (var claim in member.Claims.Where(c => c.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase))) { <button type="button" disabled="@(busy || (claim.Type == "PERCENT_DISCOUNT" && spend < 1))" @onclick="() => RedeemReward(claim)" class="flex min-h-11 w-full items-center justify-between rounded-xl border border-zinc-200 px-3 text-left text-sm"><span>@claim.Name</span><span>Redeem</span></button> }</div>
                }
                <button type="button" disabled="@(busy || member.AvailableCashback < setup.Policy.MinWithdrawal)" @onclick="PayCashback" class="h-11 w-full rounded-xl border border-zinc-300 text-sm font-semibold">Pay @Money(member.AvailableCashback) MMK cashback</button>
                <div class="border-t border-zinc-100 pt-4"><h3 class="font-semibold">Customer identifier QR</h3><div id="memberQr" class="mt-3 h-56 w-56 rounded-xl border border-zinc-200 p-2"></div><button type="button" @onclick="CopyMemberUrl" class="mt-2 block text-sm font-semibold underline">Copy member link</button><p class="mt-2 text-xs text-zinc-600">The link contains only the public shop ID and member token. It does not expose balance or personal details.</p></div>
            </section>
        }
    </div>
}
else
{
    <div class="space-y-6">
