@page "/"
@page "/setup"
@page "/cashier"
@page "/member"
@page "/privacy"
@page "/terms"
@using Ahm.Models
@using Ahm.Services
@inject BrowserStore Store
@inject GoogleSheetsService Sheets
@inject NavigationManager Nav
@inject IConfiguration Configuration
@inject IJSRuntime Js

<PageTitle>@Title</PageTitle>
@if (page == "member") { <HeadContent><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" /></HeadContent> }

@if (page is not ("privacy" or "terms"))
{
    <div class="mb-5 flex justify-end">
        <button type="button" @onclick="ToggleLanguage" class="rounded-lg border border-zinc-200 bg-white px-3 text-xs font-semibold">@(burmese ? "English" : "မြန်မာ")</button>
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div role="@(messageIsError ? "alert" : "status")" class="mb-6 flex items-start justify-between gap-3 rounded-xl border p-4 text-sm @(messageIsError ? "border-red-300 bg-red-50 text-red-900" : "border-brand-100 bg-brand-50 text-brand-900")">
        <p>@message</p><button type="button" class="shrink-0 font-semibold underline" @onclick="DismissMessage">@T("ပိတ်မည်", "Dismiss")</button>
    </div>
}

@if (!loaded)
{
    <div role="status" class="rounded-2xl border border-zinc-200 bg-white p-6 text-sm">@T("အမ်းကို ဖွင့်နေသည်…", "Loading Ahm…")</div>
}
else if (page == "privacy")
{
    <article class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Privacy</p>
        <h1 class="mt-2 text-xl font-semibold"><span lang="my" class="block">ကိုယ်ရေးအချက်အလက် မူဝါဒ</span><span lang="en" class="mt-1 block">Privacy Policy</span></h1>
        <nav aria-label="Privacy policy languages" class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
            <a href="/privacy#privacy-myanmar" lang="my" class="inline-flex min-h-11 items-center text-brand-700 underline">မြန်မာ</a>
            <a href="/privacy#privacy-english" lang="en" class="inline-flex min-h-11 items-center text-brand-700 underline">English</a>
        </nav>
        <section lang="my" aria-labelledby="privacy-myanmar" class="mt-6 space-y-5 text-sm leading-7 text-zinc-700">
            <h2 id="privacy-myanmar" class="text-base font-semibold text-brand-800">မြန်မာ</h2>
            <p>အမ်း (Ahm) ကို အသုံးပြုသည့်အခါ ဆိုင်နှင့် ဖောက်သည်အချက်အလက်များကို မည်သို့ ကိုင်တွယ်သည်ကို ဤစာမျက်နှာတွင် ရှင်းပြထားသည်။</p>
            <div>
                <h3 class="font-semibold text-zinc-900">ဆိုင်နှင့် ဖောက်သည်မှတ်တမ်းများ</h3>
                <p>ဖောက်သည်အမည်၊ ဖုန်းနံပါတ်၊ ဝယ်ယူမှုနှင့် ဆုလက်ဆောင်မှတ်တမ်းများကို ဆိုင်က ရွေးချယ်ချိတ်ဆက်ထားသော Google Sheet တွင် သိမ်းဆည်းသည်။ သင့် browser သည် ထို Sheet ကို တိုက်ရိုက် ဖတ်ရှု၊ ရေးသားသည်။ အမ်း၏ ဆာဗာတွင် ထိုမှတ်တမ်းများ၏ မိတ္တူကို မသိမ်းဆည်းပါ။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Google ခွင့်ပြုချက်နှင့် ချိတ်ဆက်မှု</h3>
                <p>အမ်းသည် အမ်းနှင့်အတူ ဖန်တီးထားသော သို့မဟုတ် ရွေးချယ်ချိတ်ဆက်ထားသော Google Drive ဖိုင်များကို ဖတ်ရှု၊ ပြင်ဆင်၊ ဖန်တီး၊ ဖျက်နိုင်သည့် <code>drive.file</code> ခွင့်ပြုချက်ကို တောင်းခံသည်။ Google ချိတ်ဆက်မှုအတွက် အသုံးပြုသော access token ကို လက်ရှိ browser session ၏ memory ထဲတွင်သာ ထားသည်။ စာမျက်နှာ ပြန်ဖွင့်ခြင်း သို့မဟုတ် token သက်တမ်းကုန်ခြင်းတွင် Google ကို ပြန်ချိတ်ရန် လိုနိုင်သည်။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">ဤစက်တွင် သိမ်းထားသော setting များ</h3>
                <p>ချိတ်ထားသော Sheet ကို မှတ်မိစေရန်နှင့် သင်၏ ရွေးချယ်မှုများကို မှတ်ထားရန် Sheet ID၊ ဆိုင် ID၊ ဝန်ထမ်းအမည်နှင့် ဘာသာစကားကဲ့သို့ setting များကို ဤ browser တွင် သိမ်းထားနိုင်သည်။ ထို browser storage တွင် Google access token နှင့် ဖောက်သည်မှတ်တမ်းများကို အမ်းက မသိမ်းဆည်းပါ။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">ဝန်ထမ်းများနှင့် ဖောက်သည် QR link များ</h3>
                <p>အမ်းတွင် ဖောက်သည်မှတ်တမ်းကို ကြည့်ရန် ဝန်ထမ်းသည် ချိတ်ထားသော Google Sheet ကို ပြင်ဆင်ခွင့်ရှိပြီး Google ကို ခွင့်ပြုချိတ်ဆက်ထားရမည်။ ဖောက်သည်၏ QR link သည် အမှတ်အသားကိုသာ ပြသပြီး အမည်၊ ဖုန်းနံပါတ်၊ လက်ကျန်နှင့် ဆုလက်ဆောင်များကို အများပြည်သူအား မပြသပါ။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Google နှင့် ဝဘ်ဆိုက် hosting</h3>
                <p>Google Sheet တွင် သိမ်းထားသော အချက်အလက်များအတွက် Google ၏ ဝန်ဆောင်မှုနှင့် ကိုယ်ရေးအချက်အလက် မူဝါဒများ သက်ဆိုင်သည်။ ဤဝဘ်ဆိုက်ကို ပို့ဆောင်ပေးသော hosting/CDN ဝန်ဆောင်မှုသည် ၎င်းတို့၏ မူဝါဒများအတိုင်း ပုံမှန် ဝင်ရောက်အသုံးပြုမှုမှတ်တမ်းများကို ကိုင်တွယ်နိုင်သည်။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Google user data ကို မျှဝေခြင်းနှင့် အသုံးပြုမှု ကန့်သတ်ချက်</h3>
                <p>အမ်းသည် Google user data ကို မရောင်းပါ၊ ကြော်ငြာ၊ credit ဆုံးဖြတ်ချက်၊ data broker သို့မဟုတ် AI/ML model လေ့ကျင့်ရေးအတွက် မသုံးပါ။ Google API များကို သဘောတူညီချက်မရှိသော အနီးကပ်ရုပ်ပုံ (non-consensual intimate imagery) များကို AI ဖြင့် ဖန်တီးခြင်း သို့မဟုတ် ကိုင်တွယ်ခြင်းအတွက်လည်း မသုံးပါ။ Google user data ကို အမ်း၏ user-facing loyalty လုပ်ဆောင်ချက်များ ပေးရန်အတွက်သာ အသုံးပြုပြီး Google API Services User Data Policy ၏ Limited Use လိုအပ်ချက်များကို လိုက်နာသည်။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">လုံခြုံရေး၊ ထိန်းသိမ်းချိန်နှင့် ဖျက်သိမ်းခြင်း</h3>
                <p>Google နှင့် အမ်းကြား data ပို့ဆောင်မှုကို HTTPS ဖြင့် ကာကွယ်ထားသည်။ Google access token ကို browser memory ထဲတွင်သာ session အတွင်း ထိန်းသိမ်းသည်။ Sheet ထဲရှိ မှတ်တမ်းများကို ထိန်းသိမ်းချိန်နှင့် ဖျက်သိမ်းမှုကို ဆိုင်ပိုင်ရှင်က Google Sheet တွင် စီမံသည်။ Browser setting များကို browser data ရှင်းလင်းခြင်းဖြင့် ဖျက်နိုင်သည်။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">ဆက်သွယ်ရန်နှင့် မူဝါဒအပြောင်းအလဲ</h3>
                <p>ကိုယ်ရေးအချက်အလက်ဆိုင်ရာ မေးမြန်းချက်သို့မဟုတ် ဖျက်သိမ်းရန်တောင်းဆိုချက်များအတွက် <a href="mailto:sannlynnhtun.developer@gmail.com" class="underline">sannlynnhtun.developer@gmail.com</a> သို့ ဆက်သွယ်နိုင်သည်။ Google user data ကို အသုံးပြုပုံ ပြောင်းလဲပါက ဤမူဝါဒကို အသစ်ပြင်မည်။ နောက်ဆုံးပြင်ဆင်ရက်—၂၀၂၆ ခုနှစ်၊ စက်တင်ဘာ ၃၀ ရက်။</p>
            </div>
        </section>
        <section lang="en" aria-labelledby="privacy-english" class="mt-8 space-y-5 border-t border-zinc-200 pt-6 text-sm leading-7 text-zinc-700">
            <h2 id="privacy-english" class="text-base font-semibold text-brand-800">English</h2>
            <p>This page explains how Ahm handles shop and customer information when you use the app.</p>
            <div>
                <h3 class="font-semibold text-zinc-900">Shop and customer records</h3>
                <p>Customer names, phone numbers, purchases and reward records are stored in the Google Sheet selected by the shop. Your browser reads and writes that Sheet directly. Ahm does not keep a copy of these records on its servers.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Google permission and connection</h3>
                <p>Ahm requests the <code>drive.file</code> permission to read, edit, create and delete Google Drive files created with or selected for the app. The access token used for this connection stays in memory for the current browser session. You may need to reconnect Google after reloading the page or when the token expires.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Settings saved on this device</h3>
                <p>To remember your connected Sheet and preferences, Ahm may save settings such as the Sheet ID, shop ID, staff label and language in this browser. Ahm does not save Google access tokens or customer records in that browser storage.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Staff access and customer QR links</h3>
                <p>To view customer records in Ahm, staff must have editing access to the connected Google Sheet and authorise their Google connection. A customer's QR link shows an identifier only. It does not publicly display their name, phone number, balance or rewards.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Google and website hosting</h3>
                <p>Google's service and privacy policies apply to information stored in Google Sheets. The hosting/CDN service that delivers this website may process standard access logs under its own policies.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Sharing and Limited Use</h3>
                <p>Ahm does not sell Google user data or share it with advertisers, data brokers, information resellers or lenders. Google user data is used only to provide the user-facing loyalty features requested by the user. It is not used for advertising, credit decisions, or to develop, improve or train generalised or non-personalised AI/ML models. Ahm does not use Google APIs to generate or process non-consensual intimate imagery or any other AI-generated content. Ahm's use and transfer of information received from Google APIs complies with the Google API Services User Data Policy, including the Limited Use requirements.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Security, retention and deletion</h3>
                <p>Ahm uses HTTPS for data in transit. Google access tokens remain only in browser memory for the current session and are not written to Ahm storage or logs. Shop and customer records remain in the shop's Google Sheet until the shop owner edits or deletes them under the shop's own retention practices. Users can remove Ahm-created or selected files in Google Drive and can clear saved Ahm settings by clearing this site's browser data.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Contact and policy changes</h3>
                <p>For privacy questions or deletion requests, email <a href="mailto:sannlynnhtun.developer@gmail.com" class="underline">sannlynnhtun.developer@gmail.com</a>. This policy will be updated before Ahm materially changes how it uses Google user data. Last updated: 30 September 2026.</p>
            </div>
        </section>
    </article>
}
else if (page == "terms")
{
    <article class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Terms</p>
        <h1 class="mt-2 text-xl font-semibold"><span lang="my" class="block">အသုံးပြုမှု စည်းကမ်းချက်များ</span><span lang="en" class="mt-1 block">Terms of Service</span></h1>
        <nav aria-label="Terms languages" class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
            <a href="/terms#terms-myanmar" lang="my" class="inline-flex min-h-11 items-center text-brand-700 underline">မြန်မာ</a>
            <a href="/terms#terms-english" lang="en" class="inline-flex min-h-11 items-center text-brand-700 underline">English</a>
        </nav>
        <section lang="my" aria-labelledby="terms-myanmar" class="mt-6 space-y-5 text-sm leading-7 text-zinc-700">
            <h2 id="terms-myanmar" class="text-base font-semibold text-brand-800">မြန်မာ</h2>
            <div>
                <h3 class="font-semibold text-zinc-900">အမ်းကို အသုံးပြုခြင်း</h3>
                <p>အမ်း (Ahm) သည် ဆိုင်များက ဝယ်ယူမှု၊ တံဆိပ်နှင့် ဆုလက်ဆောင်မှတ်တမ်းများကို မိမိတို့၏ Google Sheet ဖြင့် စီမံရန် အခမဲ့ အသုံးပြုနိုင်သော community tool ဖြစ်သည်။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">ဆိုင်ပိုင်ရှင်၏ တာဝန်များ</h3>
                <p>ဆိုင်ပိုင်ရှင်သည် Sheet မျှဝေခွင့်၊ ဖောက်သည်အချက်အလက် စုဆောင်းအသုံးပြုရန် သဘောတူညီချက်၊ ဆုလက်ဆောင် စည်းကမ်းများနှင့် မှတ်တမ်း backup များကို စီမံရန် တာဝန်ရှိသည်။ ဖောက်သည်များသည် မှတ်တမ်းပြင်ဆင်ခြင်းနှင့် ဆုလက်ဆောင်ဆိုင်ရာ မေးခွန်းများအတွက် သက်ဆိုင်ရာဆိုင်သို့ တိုက်ရိုက် ဆက်သွယ်သင့်သည်။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">ဝန်ထမ်းများ၏ ပြင်ဆင်ခွင့်</h3>
                <p>ဆိုင်၏ Google Sheet တွင် Editor ခွင့်ရှိသူတိုင်းကို ယုံကြည်ရသော ဝန်ထမ်းအဖြစ် အမ်းက သတ်မှတ်သည်။ ထိုသူများသည် Google Sheets မှတစ်ဆင့်လည်း ဆိုင်၏ မှတ်တမ်းများကို ကြည့်ရှု၊ ပြင်ဆင်နိုင်သောကြောင့် ဆိုင်ပိုင်ရှင်သည် ယုံကြည်ရသူများကိုသာ ထိုခွင့်ပေးသင့်သည်။</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">ဝန်ဆောင်မှု ကန့်သတ်ချက်များ</h3>
                <p>အမ်းကို အသုံးပြုနိုင်မှုသည် Google Sheets နှင့် hosting ဝန်ဆောင်မှုတို့၏ အသုံးပြုမှုပမာဏ ကန့်သတ်ချက်များ၊ ဝန်ဆောင်မှုအခြေအနေနှင့် မူဝါဒအပြောင်းအလဲများအပေါ် မူတည်သည်။ အမ်းသည် ဆိုင်၏ loyalty မှတ်တမ်းများကို စီမံပေးသော tool ဖြစ်ပြီး ငွေပေးချေမှု ဝန်ဆောင်မှု သို့မဟုတ် စာရင်းကိုင်စနစ် မဟုတ်ပါ။</p>
            </div>
        </section>
        <section lang="en" aria-labelledby="terms-english" class="mt-8 space-y-5 border-t border-zinc-200 pt-6 text-sm leading-7 text-zinc-700">
            <h2 id="terms-english" class="text-base font-semibold text-brand-800">English</h2>
            <div>
                <h3 class="font-semibold text-zinc-900">Using Ahm</h3>
                <p>Ahm is a free community tool that helps shops manage purchases, stamps and reward records in their own Google Sheet.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Shop owner responsibilities</h3>
                <p>The shop owner is responsible for Sheet sharing, consent to collect and use customer information, reward rules and record backups. Customers should contact their shop directly about record corrections or reward questions.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Staff editing access</h3>
                <p>Ahm treats every editor of a shop's Google Sheet as a trusted operator. These editors can also view and change the shop's records in Google Sheets, so the shop owner should grant editing access only to people they trust.</p>
            </div>
            <div>
                <h3 class="font-semibold text-zinc-900">Service limitations</h3>
                <p>Ahm's availability depends on Google Sheets and hosting usage limits, service availability and policy changes. Ahm manages shop loyalty records. It does not process payments or replace an accounting system.</p>
            </div>
        </section>
    </article>
}
else if (page == "member")
{
    <section class="space-y-5 rounded-2xl border border-zinc-200 bg-white p-6 text-center shadow-sm">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-2xl">◇</div>
        <div><p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Staff-assisted member ID</p><h1 class="mt-2 text-xl font-semibold">@T("ဤ QR ကို ဆိုင်ဝန်ထမ်းအား ပြပါ", "Show this QR to shop staff")</h1></div>
        <p class="text-sm leading-6 text-zinc-700">@T("ဤစာမျက်နှာတွင် balance သို့မဟုတ် customer အချက်အလက် မပြပါ။ ချိတ်ထားသော အမ်း Sheet ကို authorize လုပ်ထားသည့် ဝန်ထမ်းကသာ member record ကို ရှာနိုင်သည်။", "This page does not show balances or customer details. Only staff authorized for the connected Ahm Sheet can look up the member record.")</p>
        @if (validMemberLink)
        {
            <div id="publicMemberQr" class="mx-auto h-56 w-56 rounded-xl border border-zinc-200 bg-white p-3"></div>
            <p class="break-all font-mono text-xs text-zinc-600">@memberToken</p>
            @if (setup.PublicShopId == publicShopId)
            {
                <a href="@($"/cashier?s={Uri.EscapeDataString(publicShopId)}&t={Uri.EscapeDataString(memberToken)}")" class="inline-flex min-h-11 items-center rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@T("ဝန်ထမ်းအဖြစ် ဖွင့်မည်", "Open staff lookup")</a>
            }
        }
        else { <p role="alert" class="text-sm text-red-800">@T("Member link မမှန်ပါ။ ဆိုင်ထံမှ QR အသစ်တောင်းပါ။", "This member link is invalid. Ask the shop for a new QR.")</p> }
    </section>
}
else if (page == "setup")
{
    <div class="space-y-6">
        <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Google Sheets direct</p>
            <h1 class="mt-2 text-xl font-semibold">@T("ဆိုင် Sheet ချိတ်ဆက်ခြင်း", "Connect your shop Sheet")</h1>
            <p class="mt-2 text-sm leading-6 text-zinc-700">@T("Desktop၊ Apps Script၊ database နှင့် cashier PIN မလိုပါ။ Google account ကို ခွင့်ပြုပြီး mobile browser မှ Sheet ကို တိုက်ရိုက်ရွေးပါ။", "No desktop, Apps Script, database or cashier PIN is required. Authorize Google and select the Sheet directly from a mobile browser.")</p>
            @if (!googleConfigured) { <p role="alert" class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">Google public configuration is missing. Set <code>Google:ClientId</code>, <code>Google:ApiKey</code> and <code>Google:AppId</code> before deployment.</p> }
            <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" disabled="@(!googleConfigured || busy)" @onclick="ConnectGoogle" class="rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@(googleConnected ? T("Google ပြန်ချိတ်မည်", "Reconnect Google") : T("Google ချိတ်မည်", "Connect Google"))</button>
                @if (googleConnected) { <span class="self-center text-xs font-medium text-brand-700">● @T("ဤ session အတွက် ချိတ်ထားသည်", "Connected for this session")</span> }
            </div>
            <p class="mt-3 text-xs text-zinc-600">@T("တောင်းဆိုသည့် scope: Google ၏ official “See, edit, create, and delete only the specific Google Drive files you use with this app” (drive.file). Token ကို browser memory မှာသာ ထားသည်။", "Requested scope: Google's official “See, edit, create, and delete only the specific Google Drive files you use with this app” (drive.file). The token stays in browser memory only.")</p>
        </section>

        <section class="space-y-4 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <label class="block text-sm font-medium">@T("ဆိုင်အမည်", "Shop name")<input maxlength="100" @bind="setup.ShopName" placeholder="e.g. Shwe Tea House" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
            <label class="block text-sm font-medium">@T("ဤဖုန်း၏ ဝန်ထမ်းအမည်", "Staff label on this device")<input maxlength="100" @bind="setup.StaffLabel" placeholder="e.g. Front counter" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
            <div class="grid gap-3 sm:grid-cols-2">
                <button type="button" disabled="@(!googleConnected || busy)" @onclick="CreateShop" class="rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@T("Ahm Sheet အသစ်ဖန်တီးမည်", "Create new Ahm Sheet")</button>
                <button type="button" disabled="@(!googleConnected || busy)" @onclick="ConnectExisting" class="rounded-xl border border-zinc-300 px-4 text-sm font-semibold">@T("ရှိပြီး Sheet ရွေးမည်", "Connect existing Sheet")</button>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(setup.SpreadsheetId))
        {
            <form @onsubmit="SaveSettings" @onsubmit:preventDefault class="space-y-5 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
                <div><p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Connected</p><h2 class="mt-1 text-lg font-semibold">@setup.ShopName</h2><p class="mt-1 break-all font-mono text-xs text-zinc-500">Sheet @setup.SpreadsheetId</p></div>
                <label class="block text-sm font-medium">@T("ဆိုင်အမည်", "Shop name")<input required maxlength="100" @bind="setup.ShopName" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                <div class="grid gap-4 sm:grid-cols-2">
                    <label class="text-sm">Spend per stamp (MMK)<input required type="number" min="1" @bind="setup.Policy.MinSpendPerStamp" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                    <label class="text-sm">Stamps per card<input required type="number" min="1" max="30" @bind="setup.Policy.MaxStamps" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                    <label class="text-sm">Minimum payout (MMK)<input required type="number" min="1" @bind="setup.Policy.MinWithdrawal" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                </div>
                <div class="space-y-3 border-t border-zinc-100 pt-4">
                    <div class="flex items-center justify-between"><h2 class="font-semibold">Reward catalog</h2><button id="add-reward" type="button" @onclick="AddReward" class="text-sm font-semibold underline">Add reward</button></div>
                    @foreach (var reward in setup.Rewards)
                    {
                        <fieldset @key="reward.Id" class="space-y-3 rounded-xl border border-zinc-200 p-4">
                            <label class="block text-sm">Name<input required maxlength="100" @bind="reward.Name" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3" /></label>
                            <label class="block text-sm">Type<select @bind="reward.Type" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3"><option value="CASHBACK">Cashback</option><option value="PERCENT_DISCOUNT">Percentage discount</option><option value="FREE_ITEM">Free item</option></select></label>
                            @if (reward.Type != "FREE_ITEM") { <label class="block text-sm">Value<input type="number" min="1" @bind="reward.Value" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3" /></label> }
                            @if (reward.Type == "PERCENT_DISCOUNT") { <label class="block text-sm">Maximum discount<input type="number" min="0" @bind="reward.MaxDiscount" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3" /></label> }
                            <label class="block text-sm">Stock (blank = unlimited)<input type="number" min="0" @bind="reward.StockQuantity" class="mt-1 h-11 w-full rounded-lg border border-zinc-200 px-3" /></label>
                            <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" @bind="reward.Active" class="h-5 w-5" /> Active</label>
                            <button type="button" @onclick="() => DisableReward(reward)" class="text-sm font-semibold text-red-800 underline">@(reward.Active ? "Disable" : "Remove")</button>
                        </fieldset>
                    }
                </div>
                <button disabled="@(!googleConnected || busy)" class="h-11 w-full rounded-xl bg-brand-700 text-sm font-semibold text-white">@T("Setting များ Sheet သို့ သိမ်းမည်", "Save settings to Sheet")</button>
            </form>
        }

    </div>
}
else if (page == "cashier")
{
    <div class="space-y-6">
        <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Staff workspace</p><h1 class="mt-1 text-xl font-semibold">@(string.IsNullOrWhiteSpace(setup.ShopName) ? "Ahm" : setup.ShopName)</h1></div><button type="button" disabled="@(!googleConfigured || busy)" @onclick="ConnectGoogle" class="rounded-xl border border-zinc-300 px-3 text-sm font-semibold">@(googleConnected ? T("ပြန် sync မည်", "Sync now") : T("Google ပြန်ချိတ်မည်", "Reconnect Google"))</button></div>
            @if (string.IsNullOrWhiteSpace(setup.SpreadsheetId)) { <p class="mt-4 text-sm"><a href="/setup" class="font-semibold underline">@T("ဆိုင် Sheet အရင်ချိတ်ပါ", "Connect a shop Sheet first")</a></p> }
            else if (!googleConnected) { <p class="mt-3 text-sm text-amber-800">@T("Token သက်တမ်းကုန် သို့မဟုတ် page reload ဖြစ်သည်။ ပြင်ဆင်မှုအားလုံးကို ရပ်ထားပြီး Reconnect Google ကို ကိုယ်တိုင်နှိပ်ရမည်။", "The token expired or the page was reloaded. Mutations are paused until you explicitly reconnect Google.")</p> }
        </section>
        <section class="space-y-3 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <label class="block text-sm font-medium">@T("ဖုန်းနံပါတ်၊ member token သို့မဟုတ် QR link", "Phone, member token or QR link")<input @bind="lookup" @bind:event="oninput" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
            <div class="flex flex-wrap gap-2"><button type="button" disabled="@(!googleConnected || busy)" @onclick="FindMember" class="rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@T("Member ရှာမည်", "Find member")</button><button type="button" disabled="@(!googleConnected || busy)" @onclick="ScanQr" class="rounded-xl border border-zinc-300 px-4 text-sm font-semibold">@T("QR scan မည်", "Scan QR")</button></div>
        </section>
        @if (showEnroll)
        {
            <form @onsubmit="Enroll" @onsubmit:preventDefault class="space-y-3 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm"><h2 class="font-semibold">@T("Member အသစ်", "New member")</h2><label class="block text-sm">Name<input required maxlength="100" @bind="newName" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label><button disabled="@busy" class="h-11 w-full rounded-xl bg-brand-700 text-sm font-semibold text-white">@T("Member ဖန်တီးမည်", "Create member")</button></form>
        }
        @if (member is not null)
        {
            <section class="space-y-5 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
                <div class="flex flex-wrap justify-between gap-3"><div><h2 class="text-lg font-semibold">@member.Name</h2><p class="text-sm text-zinc-600">@member.Phone</p></div><div class="text-right"><p class="text-xs text-zinc-600">Cashback</p><p class="font-semibold text-brand-800">@Money(member.AvailableCashback) MMK</p></div></div>
                <p class="text-sm">@member.Stamps / @setup.Policy.MaxStamps stamps · @member.RewardCredits reward choices · @Money(member.SpendRemainder) MMK carried</p>
                <label class="block text-sm">Bill amount (MMK)<input type="number" min="1" @bind="spend" class="mt-1 h-11 w-full rounded-xl border border-zinc-200 px-3" /></label>
                <button type="button" disabled="@(!googleConnected || busy || spend < 1)" @onclick="RecordPurchase" class="h-11 w-full rounded-xl bg-brand-700 text-sm font-semibold text-white">@T("ဝယ်ယူမှု မှတ်တမ်းတင်မည်", "Record purchase")</button>
                @if (member.RewardCredits > 0)
                {
                    <div class="space-y-2 border-t border-zinc-100 pt-4"><h3 class="font-semibold">@T("Reward ရွေးမည်", "Select reward")</h3>@foreach (var reward in setup.Rewards.Where(r => r.Active)) { <button type="button" disabled="@(busy || RemainingStock(reward) == 0)" @onclick="() => SelectReward(reward)" class="flex min-h-11 w-full items-center justify-between rounded-xl border border-zinc-200 px-3 text-left text-sm"><span>@reward.Name</span><span>@RewardLabel(reward)@(RemainingStock(reward) is int remaining ? $" · {remaining} left" : "")</span></button> }</div>
                }
                @if (member.Claims.Any(c => c.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase)))
                {
                    <div class="space-y-2 border-t border-zinc-100 pt-4"><h3 class="font-semibold">@T("အသုံးပြုရန် Reward", "Rewards to redeem")</h3>@foreach (var claim in member.Claims.Where(c => c.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase))) { <button type="button" disabled="@(busy || (claim.Type == "PERCENT_DISCOUNT" && spend < 1))" @onclick="() => RedeemReward(claim)" class="flex min-h-11 w-full items-center justify-between rounded-xl border border-zinc-200 px-3 text-left text-sm"><span>@claim.Name</span><span>Redeem</span></button> }</div>
                }
                <button type="button" disabled="@(busy || member.AvailableCashback < setup.Policy.MinWithdrawal)" @onclick="PayCashback" class="h-11 w-full rounded-xl border border-zinc-300 text-sm font-semibold">Pay @Money(member.AvailableCashback) MMK cashback</button>
                <div class="border-t border-zinc-100 pt-4"><h3 class="font-semibold">Customer identifier QR</h3><div id="memberQr" class="mt-3 h-56 w-56 rounded-xl border border-zinc-200 p-2"></div><button type="button" @onclick="CopyMemberUrl" class="mt-2 block text-sm font-semibold underline">Copy member link</button><p class="mt-2 text-xs text-zinc-600">The link contains only the public shop ID and member token. It does not expose balance or personal details.</p></div>
            </section>
        }
    </div>
}
else
{
    <div class="space-y-6">
        <section class="rounded-2xl border border-zinc-200 bg-white p-7 shadow-sm"><p class="text-xs font-semibold uppercase tracking-wider text-brand-700">Ahm (အမ်း) · Free · browser-direct · Google Sheets</p><h1 class="mt-2 text-2xl font-semibold"><span class="block">Ahm</span><span class="mt-1 block text-lg">@T("ဆိုင်ဝန်ထမ်းများအတွက် ရိုးရှင်းသော loyalty workspace", "A simple loyalty workspace for shop staff")</span></h1><p class="mt-3 text-sm leading-7 text-zinc-700">@T("အမ်း (Ahm) သည် ဆိုင်ပိုင်ရှင်နှင့် ခွင့်ပြုထားသော ဝန်ထမ်းများက ဝယ်ယူမှု၊ stamp၊ cashback နှင့် reward မှတ်တမ်းများကို ဆိုင်ပိုင် Google Sheet ထဲတွင် စီမံရန် ကူညီသည်။ ဤ homepage ကို Google login မဝင်ဘဲ ကြည့်နိုင်သည်။", "Ahm helps shop owners and authorised staff record purchases, stamps, cashback and rewards in a Google Sheet owned by the shop. This public homepage is available without signing in.")</p><p class="mt-3 text-sm leading-7 text-zinc-700">@T("Google ကို ချိတ်ဆက်ရန် ရွေးချယ်ပါက အမ်းသည် သင်ရွေးထားသော သို့မဟုတ် အမ်းနှင့်အတူ ဖန်တီးထားသော Google Drive file များကိုသာ ဖန်တီး၊ ဖွင့်နှင့် ပြင်ဆင်ရန် drive.file ခွင့်ပြုချက်ကို တောင်းသည်။ Drive တစ်ခုလုံးကို ကြည့်ရန် မတောင်းပါ။", "When a user chooses to connect Google, Ahm requests the drive.file permission so the browser can create, open and update only files created with or selected for Ahm. It does not request access to the user's entire Drive.")</p><div class="mt-5 flex flex-wrap gap-3"><a href="/setup" class="inline-flex min-h-11 items-center rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white">@T("ဆိုင်ချိတ်ဆက်မည်", "Connect a shop")</a><a href="/cashier" class="inline-flex min-h-11 items-center rounded-xl border border-zinc-300 px-4 text-sm font-semibold">@T("Staff workspace", "Staff workspace")</a><a href="/privacy" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand-700 underline">@T("ကိုယ်ရေးအချက်အလက် မူဝါဒ", "Privacy Policy")</a></div></section>
        <section class="grid gap-3 sm:grid-cols-3"><div class="rounded-xl border border-zinc-200 bg-white p-4"><p class="font-semibold">No Apps Script</p><p class="mt-1 text-xs text-zinc-600">Create or choose a Sheet from mobile.</p></div><div class="rounded-xl border border-zinc-200 bg-white p-4"><p class="font-semibold">No Ahm database</p><p class="mt-1 text-xs text-zinc-600">Your Sheet remains the data store.</p></div><div class="rounded-xl border border-zinc-200 bg-white p-4"><p class="font-semibold">Staff-only details</p><p class="mt-1 text-xs text-zinc-600">Customer links reveal no private balance.</p></div></section>
        <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">@T("Google data ကို အမ်းက ဘယ်လိုသုံးသလဲ", "How Ahm uses Google data")</h2><p class="mt-2 text-sm leading-7 text-zinc-700">@T("Google user data ကို အမ်း၏ မြင်ရသော loyalty လုပ်ဆောင်ချက်များအတွက်သာ အသုံးပြုသည်။ ကြော်ငြာ၊ credit ဆုံးဖြတ်ချက်၊ data ရောင်းချခြင်း၊ AI/ML လေ့ကျင့်ခြင်း၊ သဘောတူညီချက်မရှိသော အနီးကပ်ရုပ်ပုံ (non-consensual intimate imagery) များကို AI ဖြင့် ဖန်တီးခြင်း သို့မဟုတ် ကိုင်တွယ်ခြင်းအတွက် မသုံးပါ။", "Google user data is used only for Ahm's visible loyalty features. It is not sold, used for advertising or credit decisions, used to train AI/ML models, or used to generate or process intimate imagery.")</p></section>
    </div>
}
