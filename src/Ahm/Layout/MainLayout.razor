@inherits LayoutComponentBase
@inject NavigationManager Nav

@{ var isMemberPage = new Uri(Nav.Uri).AbsolutePath.Equals("/member", StringComparison.OrdinalIgnoreCase); }

<div class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-30 w-full border-b border-zinc-200/80 bg-white/90 backdrop-blur-md">
        <div class="mx-auto flex min-h-14 max-w-2xl flex-wrap items-center justify-between gap-3 px-5 py-2">
            @if (isMemberPage)
            {
                <div class="flex items-center gap-2.5"><span class="flex h-7 w-7 items-center justify-center rounded-lg bg-black text-xs font-bold text-white">အ</span><span class="text-sm font-semibold tracking-tight text-zinc-900">အမ်း</span></div>
            }
            else
            {
                <a href="/" class="flex items-center gap-2.5 no-underline"><span class="flex h-7 w-7 items-center justify-center rounded-lg bg-black text-xs font-bold text-white">အ</span><span class="text-sm font-semibold tracking-tight text-zinc-900">အမ်း</span></a>
            }
            @if (!isMemberPage)
            {
            <nav aria-label="Main navigation" class="flex rounded-full border border-zinc-200/60 bg-zinc-100 p-0.5 text-xs">
                <NavLink href="/" Match="NavLinkMatch.All" class="rounded-full px-3 py-1 text-zinc-500" ActiveClass="bg-white font-medium text-zinc-900 shadow-sm">Customer</NavLink>
                <NavLink href="/cashier" class="rounded-full px-3 py-1 text-zinc-500" ActiveClass="bg-white font-medium text-zinc-900 shadow-sm">Cashier</NavLink>
                <NavLink href="/setup" class="rounded-full px-3 py-1 text-zinc-500" ActiveClass="bg-white font-medium text-zinc-900 shadow-sm">Setup</NavLink>
            </nav>
            }
        </div>
    </header>
    <main class="mx-auto w-full max-w-2xl flex-1 px-5 py-8">@Body</main>
    <footer class="border-t border-zinc-200/60 py-4 text-center font-mono text-[11px] text-zinc-400">အမ်း (Ahm) • Smart Loyalty, Earn Cashback</footer>
</div>
