@inherits LayoutComponentBase
@inject NavigationManager Nav

@{ var isMemberPage = new Uri(Nav.Uri).AbsolutePath.Equals("/member", StringComparison.OrdinalIgnoreCase); }

<div class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-30 w-full border-b border-brand-100 bg-white/90 backdrop-blur-md">
        <div class="mx-auto flex min-h-14 max-w-2xl flex-wrap items-center justify-between gap-3 px-5 py-2">
            @if (isMemberPage)
            {
                <div class="flex items-center gap-2.5"><img src="/logo.svg" alt="" width="32" height="32" class="h-8 w-8" /><span class="text-sm font-semibold tracking-tight text-brand-900">အမ်း</span></div>
            }
            else
            {
                <a href="/" aria-label="Ahm home" class="flex items-center gap-2.5 no-underline"><img src="/logo.svg" alt="" width="32" height="32" class="h-8 w-8" /><span class="text-sm font-semibold tracking-tight text-brand-900">အမ်း</span></a>
            }
            @if (!isMemberPage)
            {
            <nav aria-label="Main navigation" class="flex rounded-full border border-brand-100 bg-brand-50 p-0.5 text-xs">
                <NavLink href="/" Match="NavLinkMatch.All" class="rounded-full px-3 py-1 text-zinc-500" ActiveClass="bg-white font-medium text-brand-800 shadow-sm">Customer</NavLink>
                <NavLink href="/cashier" class="rounded-full px-3 py-1 text-zinc-500" ActiveClass="bg-white font-medium text-brand-800 shadow-sm">Cashier</NavLink>
                <NavLink href="/setup" class="rounded-full px-3 py-1 text-zinc-500" ActiveClass="bg-white font-medium text-brand-800 shadow-sm">Setup</NavLink>
            </nav>
            }
        </div>
    </header>
    <main class="mx-auto w-full max-w-2xl flex-1 px-5 py-8">@Body</main>
    <footer class="border-t border-brand-100 py-4 text-center font-mono text-[11px] text-brand-600">အမ်း (Ahm) • Smart Loyalty, Earn Cashback</footer>
</div>
